{
  "name": "@concord/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "node dist/migrate-cli.js",
    "seed": "node dist/seed-cli.js",
    "admin": "node dist/admin-cli.js",
    "recover-account": "node dist/recover-account-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "sharp": "0.33.5",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "esbuild": "0.24.2"
  },
  "packageManager": "pnpm@11.25.0"
}
