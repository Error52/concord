# HTTPS proxy for LAN testing. SITE_ADDRESS comes from APP_URL, e.g. https://192.168.1.20:8443
{
	# Certificates from Caddy's own local CA; nothing is requested from the internet.
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Opening https://192.168.x.x sends no SNI (IP addresses never do) — without this the TLS handshake fails
	# with ERR_SSL_PROTOCOL_ERROR.
	default_sni {$DEFAULT_SNI}
}

{$SITE_ADDRESS}, https://localhost:{$HTTPS_PORT} {
	tls internal
	encode zstd gzip
	reverse_proxy frontend:80 {
		# WebSockets (/api/gateway, /livekit) are proxied transparently.
		flush_interval -1
	}
}
