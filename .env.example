# ─────────────────────────────────────────────────────────────────────────────
# Concord configuration. Copy to .env:   cp .env.example .env
# The values below work out of the box for LOCAL development on http://localhost.
# Generate fresh secrets for anything reachable from a network:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used for links in emails and CORS/CSRF origin checks)
APP_URL=http://localhost
# Public server: domain for the Let's Encrypt certificate and a contact email (./scripts/setup.sh --server)
DOMAIN=
ACME_EMAIL=
# nginx (frontend) binding; on a server it listens only on 127.0.0.1 behind Caddy
HTTP_BIND=127.0.0.1
HTTP_PORT=80
# HTTPS port of the optional Caddy proxy (LAN mode)
HTTPS_PORT=8443
# dev = this computer (+Mailpit) · https,dev = local network with a local CA · server = public server with Let's Encrypt
COMPOSE_PROFILES=dev
PUBLIC_HTTPS_PORT=443
# Set to true when serving over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=true
# email = verification email; secret-word = local beta registration/recovery without mail.
# Existing verified users and platform administrators keep access. See docs/ACCOUNT-RECOVERY.md.
ACCOUNT_VERIFICATION_MODE=email
# Demo only: let a signed-in user open their own verification letter. Does not prove real email ownership.
# Disable with real SMTP/public deployment.
DEMO_MAILBOX=false

# PostgreSQL
POSTGRES_USER=concord
POSTGRES_PASSWORD=concord-dev-password
POSTGRES_DB=concord
# Keep the image family used to create an existing volume; see docs/UPGRADING.md.
POSTGRES_IMAGE=postgres:16-bookworm
# Optional trusted registry for restricted networks. HTTPS and lockfile integrity remain enabled.
NPM_REGISTRY=https://registry.npmjs.org
# Used directly only when running the backend outside Docker:
DATABASE_URL=postgres://concord:concord-dev-password@localhost:5432/concord

# Redis (cache, presence, rate limits, pub/sub fan-out)
REDIS_URL=redis://localhost:6379

# Auth: HS256 signing key for access tokens (≥ 32 chars)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# File storage: "local" keeps uploads in the Docker volume "uploads" (default, nothing to set up).
# "s3" uses any S3-compatible service (AWS S3, Cloudflare R2, Yandex Object Storage, Selectel, self-hosted Garage/SeaweedFS…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=concord
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=25

# LiveKit SFU (API secret ≥ 32 chars)
LIVEKIT_API_KEY=concord
LIVEKIT_API_SECRET=dev-only-livekit-secret-change-me-0123456789
# Path (proxied by nginx) or absolute wss:// URL the browser uses for signalling
LIVEKIT_PUBLIC_URL=/livekit
# IP address browsers use to reach the SFU media ports (7882/udp, 7881/tcp).
# 127.0.0.1 works for testing on this machine; use your LAN/public IP for other devices.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_ENABLE_LOOPBACK=true
# Public Docker installs advertise both the public and internal SFU media candidate.
LIVEKIT_ADVERTISE_INTERNAL_IP=true

# TURN (coturn) — relay for clients that cannot reach the SFU directly
TURN_SERVER=turn:localhost:3478
TURN_PUBLIC_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1
TURN_USERNAME=concord
TURN_PASSWORD=dev-only-turn-password-change-me
# On a public server the TURN relay must not reach private networks (filled in by setup.sh --server)
TURN_DENY_A=
TURN_DENY_B=
TURN_DENY_C=

# GIFs: giphy | tenor | none. The key stays on the backend only.
GIF_PROVIDER=giphy
GIF_API_KEY=

# Email (password reset). Mailpit catches everything locally: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
MAIL_FROM=Concord <no-reply@concord.local>
# Optional separate key (32+ characters). Defaults to JWT_SECRET; keep it stable while mail is queued.
MAIL_ENCRYPTION_KEY=

# Create demo users/servers/messages on first start (alice/bob/carol/dave @concord.local, password demo12345)
SEED_ON_START=1
# Only for local/LAN demos: grant platform admin to the first account on an empty database.
# Public setup writes false. Existing installations without this flag default to false in Docker.
BOOTSTRAP_FIRST_ADMIN=true
# Администраторы платформы через запятую, только после настоящего SMTP-подтверждения.
# Права можно выдать с сервера командой: make admin EMAIL=you@example.com
PLATFORM_ADMIN_EMAILS=
LOG_LEVEL=info
