{
  "name": "@concord/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node test/e2e.mjs",
    "test:composer": "node test/composer-reliability.mjs",
    "test:calls": "node test/call-lifecycle.mjs",
    "test:pickers": "node test/picker-profile-recovery.mjs",
    "test:recovery": "node test/recovery.mjs",
    "test:edges": "node test/edge-cases.mjs",
    "test:webrtc": "node test/webrtc.mjs",
    "test:media": "node test/media-benchmark.mjs",
    "test:responsive": "node test/responsive-audit.mjs",
    "test:screen": "node test/screen-share.mjs",
    "test:auth": "node test/auth-flow.mjs",
    "test:lan": "node test/lan.mjs"
  },
  "dependencies": {
    "livekit-client": "2.22.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.24.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "playwright": "1.63.0"
  },
  "packageManager": "pnpm@11.25.0"
}
